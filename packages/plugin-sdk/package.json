{
  "name": "@vinhnt-sdk/plugin-sdk",
  "version": "0.1.0",
  "engines": { "node": ">=20" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./npm-loader": {
      "types": "./dist/npm-loader.d.ts",
      "import": "./dist/npm-loader.js",
      "require": "./dist/npm-loader.js"
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "npm-loader": ["./dist/npm-loader.d.ts"]
    }
  },
  "homepage": "https://github.com/vinhnt-develop/vnt-agent/tree/main/packages/plugin-sdk",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vnt-agent/issues"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vnt-agent.git",
    "directory": "packages/plugin-sdk"
  },
  "keywords": [
    "vnt",
    "plugin",
    "sdk",
    "extension",
    "hooks"
  ],
  "description": "Plugin SDK for VNT Agent — define plugins with TypeScript hooks and auto-install support",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "sideEffects": false,
  "dependencies": {
    "@vinhnt-sdk/agent-core": "workspace:*"
  }
}
