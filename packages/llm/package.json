{
  "name": "@vinhnt-sdk/llm",
  "version": "0.1.3",
  "description": "LLM capability seam — adapter abstraction, registry, retry, token metering",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git",
    "directory": "packages/llm"
  },
  "homepage": "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/llm",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
  },
  "keywords": [
    "vnt",
    "llm",
    "adapter",
    "registry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vinhnt-sdk/schema": "workspace:*",
    "@vinhnt-sdk/config": "workspace:*",
    "@vinhnt-sdk/tools": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
