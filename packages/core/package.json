{
  "name": "@vinhnt-sdk/core",
  "version": "0.1.2",
  "description": "Core agent engine for VNT Agent — kernel, tools, sessions, plugins, permissions, and knowledge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
  },
  "keywords": [
    "vnt",
    "agent",
    "core",
    "kernel",
    "tools",
    "session",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@vinhnt-sdk/schema": "workspace:*",
    "@vinhnt-sdk/security": "workspace:*",
    "@vinhnt-sdk/knowledge": "workspace:*",
    "@vinhnt-sdk/tools": "workspace:*",
    "zod": "^4.4.3"
  }
}
