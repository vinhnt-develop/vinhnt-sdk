{
  "name": "@vinhnt-sdk/observability",
  "version": "0.1.0",
  "engines": { "node": ">=20" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/vinhnt-develop/vnt-agent/tree/main/packages/observability",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vnt-agent/issues"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vnt-agent.git",
    "directory": "packages/observability"
  },
  "keywords": [
    "vnt",
    "observability",
    "logging",
    "tracing",
    "opentelemetry",
    "audit"
  ],
  "description": "Observability stack for VNT Agent — logging, tracing, audit, and OpenTelemetry integration",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "sideEffects": false,
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@vinhnt-sdk/agent-core": "workspace:*",
    "@vinhnt-sdk/plugin-sdk": "workspace:*",
    "@vinhnt-sdk/schema": "workspace:*"
  }
}
