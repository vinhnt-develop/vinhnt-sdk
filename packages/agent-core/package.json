{
    "name":  "@vinhnt-sdk/agent-core",
    "version":  "0.1.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "type":  "module",
    "main":  "./dist/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "files":  [
                                            "dist",
                                            "LICENSE"
                                        ],
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.js"
                          },
                    "./arity":  {
                                    "types":  "./dist/tool/arity.d.ts",
                                    "import":  "./dist/tool/arity.js"
                                },
                    "./fakes":  {
                                    "types":  "./dist/fakes/index.d.ts",
                                    "import":  "./dist/fakes/index.js"
                                },
                    "./kernel/*":  {
                                       "types":  "./dist/kernel/*.d.ts",
                                       "import":  "./dist/kernel/*.js"
                                   },
                    "./tool/*":  {
                                     "types":  "./dist/tool/*.d.ts",
                                     "import":  "./dist/tool/*.js"
                                 },
                    "./session/*":  {
                                        "types":  "./dist/session/*.d.ts",
                                        "import":  "./dist/session/*.js"
                                    },
                    "./agent/*":  {
                                      "types":  "./dist/agent/*.d.ts",
                                      "import":  "./dist/agent/*.js"
                                  },
                    "./skill/*":  {
                                      "types":  "./dist/skill/*.d.ts",
                                      "import":  "./dist/skill/*.js"
                                  },
                    "./permission/*":  {
                                           "types":  "./dist/permission/*.d.ts",
                                           "import":  "./dist/permission/*.js"
                                       },
                    "./plugin/*":  {
                                       "types":  "./dist/plugin/*.d.ts",
                                       "import":  "./dist/plugin/*.js"
                                   },
                    "./event-bus/*":  {
                                          "types":  "./dist/event-bus/*.d.ts",
                                          "import":  "./dist/event-bus/*.js"
                                      },
                    "./system-context/*":  {
                                               "types":  "./dist/system-context/*.d.ts",
                                               "import":  "./dist/system-context/*.js"
                                           },
                    "./knowledge/*":  {
                                          "types":  "./dist/knowledge/*.d.ts",
                                          "import":  "./dist/knowledge/*.js"
                                      },
                    "./model":  {
                                    "types":  "./dist/model.d.ts",
                                    "import":  "./dist/model.js"
                                },
                    "./tracer":  {
                                     "types":  "./dist/tracer.d.ts",
                                     "import":  "./dist/tracer.js"
                                 },
                    "./workspace":  {
                                        "types":  "./dist/workspace.d.ts",
                                        "import":  "./dist/workspace.js"
                                    },
                    "./yaml-frontmatter":  {
                                               "types":  "./dist/yaml-frontmatter.d.ts",
                                               "import":  "./dist/yaml-frontmatter.js"
                                           }
                },
    "types":  "./dist/index.d.ts",
    "typesVersions":  {
                          "*":  {
                                    "arity":  [
                                                  "./dist/tool/arity.d.ts"
                                              ],
                                    "fakes":  [
                                                  "./dist/fakes/index.d.ts"
                                              ],
                                    "kernel/*":  [
                                                     "./dist/kernel/*.d.ts"
                                                 ],
                                    "tool/*":  [
                                                   "./dist/tool/*.d.ts"
                                               ],
                                    "session/*":  [
                                                      "./dist/session/*.d.ts"
                                                  ],
                                    "agent/*":  [
                                                    "./dist/agent/*.d.ts"
                                                ],
                                    "skill/*":  [
                                                    "./dist/skill/*.d.ts"
                                                ],
                                    "permission/*":  [
                                                         "./dist/permission/*.d.ts"
                                                     ],
                                    "plugin/*":  [
                                                     "./dist/plugin/*.d.ts"
                                                 ],
                                    "event-bus/*":  [
                                                        "./dist/event-bus/*.d.ts"
                                                    ],
                                    "system-context/*":  [
                                                             "./dist/system-context/*.d.ts"
                                                         ],
                                    "knowledge/*":  [
                                                        "./dist/knowledge/*.d.ts"
                                                    ],
                                    "model":  [
                                                  "./dist/model.d.ts"
                                              ],
                                    "tracer":  [
                                                   "./dist/tracer.d.ts"
                                               ],
                                    "workspace":  [
                                                      "./dist/workspace.d.ts"
                                                  ],
                                    "yaml-frontmatter":  [
                                                             "./dist/yaml-frontmatter.d.ts"
                                                         ]
                                }
                      },
    "homepage":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/agent-core",
    "bugs":  {
                 "url":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
             },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
                       "directory":  "packages/agent-core"
                   },
    "keywords":  [
                     "vnt",
                     "agent",
                     "core",
                     "kernel",
                     "tools",
                     "session",
                     "plugin"
                 ],
    "description":  "Core agent engine for VNT Agent — kernel, tools, sessions, plugins, permissions, and knowledge",
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsc -b",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true});try{require(\u0027fs\u0027).rmSync(\u0027tsconfig.tsbuildinfo\u0027,{force:true})}catch(e){}\"",
                    "prepublishOnly":  "pnpm build"
                },
    "sideEffects":  false,
    "dependencies":  {
                         "@vinhnt-sdk/schema":  "workspace:*",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {

                        },
    "files":  [
                  "dist",
                  "LICENSE",
                  "README.md"
              ]
}