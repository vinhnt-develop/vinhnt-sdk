{
    "name":  "@vinhnt-sdk/persistence",
    "version":  "0.1.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "type": "module", "main": "./dist/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.js"
                          }
                },
    "types":  "./dist/index.d.ts",
    "homepage":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/persistence",
    "bugs":  {
                 "url":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
             },
    "files":  [
                  "dist",
                  "LICENSE"
              ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
                       "directory":  "packages/persistence"
                   },
    "keywords":  [
                     "vnt",
                     "persistence",
                     "database",
                     "sqlite",
                     "postgres",
                     "drizzle",
                     "orm"
                 ],
    "description":  "Persistence layer for VNT Agent — SQLite and PostgreSQL stores via Drizzle ORM",
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsc -b",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true});try{require(\u0027fs\u0027).rmSync(\u0027tsconfig.tsbuildinfo\u0027,{force:true})}catch(e){}\"",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:push":  "drizzle-kit push",
                    "db:studio":  "drizzle-kit studio",
                    "prepublishOnly":  "pnpm build"
                },
    "drizzle-kit":  {
                        "config":  "drizzle.config.ts"
                    },
    "sideEffects":  false,
    "dependencies":  {
                         "@vinhnt-sdk/agent-core":  "workspace:*",
                         "@vinhnt-sdk/schema":  "workspace:*",
                         "better-sqlite3":  "^12.11.1",
                         "drizzle-orm":  "^0.45.2",
                         "pg":  "^8.22.0"
                     },
    "devDependencies":  {
                            "@types/better-sqlite3":  "^7.6.13",
                            "@types/pg":  "^8.20.0",
                            "drizzle-kit":  "^0.31.10"
                        }
}