{
    "name":  "@vinhnt-sdk/config",
    "version":  "0.1.3",
    "description":  "Configuration layer for vinhnt-sdk — credential references, settings namespaces, env resolution",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "dist",
                  "LICENSE",
                  "README.md"
              ],
    "sideEffects":  false,
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "build":  "tsc -b",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "lint":  "eslint .",
                    "clean":  "node -e \"try{require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})}catch(e){}\" \u0026\u0026 node -e \"try{require(\u0027fs\u0027).rmSync(\u0027tsconfig.tsbuildinfo\u0027,{force:true})}catch(e){}\"",
                    "prepublishOnly":  "pnpm build"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/vinhnt-develop/vinhnt-sdk.git",
                       "directory":  "packages/config"
                   },
    "homepage":  "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/config",
    "bugs":  {
                 "url":  "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
             },
    "keywords":  [
                     "vnt",
                     "config",
                     "credentials",
                     "settings"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "dependencies":  {
                         "@vinhnt-sdk/schema":  "workspace:*"
                     },
    "devDependencies":  {
                            "typescript":  "^5.8.0"
                        },
    "license":  "MIT"
}
