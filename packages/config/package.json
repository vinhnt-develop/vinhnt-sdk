{
  "name": "@vinhnt-sdk/config",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./definition": {
      "types": "./dist/definition.d.ts",
      "import": "./dist/definition.js"
    }
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "definition": [
        "./dist/definition.d.ts"
      ]
    }
  },
  "homepage": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/config",
  "bugs": {
    "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
    "directory": "packages/config"
  },
  "keywords": [
    "vnt",
    "config",
    "configuration",
    "schema",
    "zod",
    "validation"
  ],
  "description": "Typed configuration schema, validation, and hierarchical config provider for VNT Agent",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "sideEffects": false,
  "dependencies": {
    "zod": "^4.4.3",
    "js-yaml": "^4.1.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
