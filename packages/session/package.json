{
    "name":  "@vinhnt-sdk/session",
"version": "0.2.0",
    "description":  "Session runtime state, run event stores, durable reload and title generation for VNT Agent",
    "license":  "MIT",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "dist",
                  "LICENSE",
                  "README.md"
              ],
    "sideEffects":  false,
    "engines":  {
                    "node":  "\u003e=20"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/vinhnt-develop/vinhnt-sdk.git",
                       "directory":  "packages/session"
                   },
    "homepage":  "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/session",
    "bugs":  {
                 "url":  "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
             },
    "keywords":  [
                     "vnt",
                     "session",
                     "state",
                     "store",
                     "agent"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsc -b",
                    "typecheck":  "tsc --noEmit",
                    "clean":  "node -e \"try{require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})}catch(e){}\" \u0026\u0026 node -e \"try{require(\u0027fs\u0027).rmSync(\u0027tsconfig.tsbuildinfo\u0027,{force:true})}catch(e){}\"",
                    "prepublishOnly":  "pnpm build",
                    "test":  "vitest run",
                    "lint":  "eslint ."
                },
    "dependencies":  {
                         "@vinhnt-sdk/schema":  "workspace:*"
                     }
}
