{
    "name": "@vinhnt-sdk/rag",
    "version": "0.1.2",
    "description": "RAG (Retrieval-Augmented Generation) module for VNT Agent — indexing, embedding, and semantic search",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
        "directory": "packages/rag"
    },
    "homepage": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/rag",
    "bugs": {
        "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
    },
    "keywords": [
        "vnt",
        "rag",
        "retrieval-augmented-generation",
        "vector",
        "embedding",
        "search"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@vinhnt-sdk/core": "workspace:*",
        "@vinhnt-sdk/schema": "workspace:*"
    },
    "peerDependencies": {
        "better-sqlite3": ">=9.0.0"
    },
    "peerDependenciesMeta": {
        "better-sqlite3": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.8",
        "better-sqlite3": "^11.0.0"
    }
}
