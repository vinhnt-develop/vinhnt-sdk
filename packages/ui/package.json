{
    "name":  "@vinhnt-sdk/ui",
    "version":  "0.1.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "type": "module", "main": "./dist/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./dist/types/index.d.ts",
                              "typesVersions":  {
                                                    "*":  {
                                                              "globals.css":  [
                                                                                  "./dist/globals.css"
                                                                              ],
                                                              "components/*":  [
                                                                                   "./dist/types/components/*.d.ts"
                                                                               ],
                                                              "hooks/*":  [
                                                                              "./dist/types/hooks/*.d.ts"
                                                                          ],
                                                              "lib/*":  [
                                                                            "./dist/types/lib/*.d.ts"
                                                                        ],
                                                              "stores/*":  [
                                                                               "./dist/types/stores/*.d.ts"
                                                                           ]
                                                          }
                                                },
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.cjs"
                          },
                    "./globals.css":  "./dist/globals.css",
                    "./components/*":  {
                                           "types":  "./dist/types/components/*.d.ts",
                                           "import":  "./dist/components/*.js",
                                           "require":  "./dist/components/*.cjs"
                                       },
                    "./hooks/*":  {
                                      "types":  "./dist/types/hooks/*.d.ts",
                                      "import":  "./dist/hooks/*.js",
                                      "require":  "./dist/hooks/*.cjs"
                                  },
                    "./lib/*":  {
                                    "types":  "./dist/types/lib/*.d.ts",
                                    "import":  "./dist/lib/*.js",
                                    "require":  "./dist/lib/*.cjs"
                                },
                    "./stores/*":  {
                                       "types":  "./dist/types/stores/*.d.ts",
                                       "import":  "./dist/stores/*.js",
                                       "require":  "./dist/stores/*.cjs"
                                   }
                },
    "types":  "./dist/types/index.d.ts",
    "homepage":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/ui",
    "bugs":  {
                 "url":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
             },
    "files":  [
                  "dist",
                  "LICENSE"
              ],
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
                       "directory":  "packages/ui"
                   },
    "keywords":  [
                     "vnt",
                     "ui",
                     "react",
                     "components",
                     "chat",
                     "settings",
                     "shadcn"
                 ],
    "description":  "Shared React UI components for VNT Agent — chat view, settings, code blocks, and ACP client",
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsup \u0026\u0026 tsc -p tsconfig.build.json \u0026\u0026 node -e \"require(\u0027fs\u0027).copyFileSync(\u0027src/globals.css\u0027,\u0027dist/globals.css\u0027)\"",
                    "dev":  "tsup --watch",
                    "typecheck":  "tsc --noEmit",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true});try{require(\u0027fs\u0027).rmSync(\u0027tsconfig.tsbuildinfo\u0027,{force:true})}catch(e){}\"",
                    "test":  "vitest run",
                    "prepublishOnly":  "pnpm build"
                },
    "sideEffects":  [
                        "**/*.css"
                    ],
    "dependencies":  {
                         "@radix-ui/react-avatar":  "^1.2.6",
                         "@radix-ui/react-dialog":  "^1.1.23",
                         "@radix-ui/react-dropdown-menu":  "^2.1.24",
                         "@radix-ui/react-label":  "^2.1.15",
                         "@radix-ui/react-select":  "^2.3.7",
                         "@radix-ui/react-slot":  "^1.2.0",
                         "clsx":  "^2.1.1",
                         "highlight.js":  "^11.11.1",
                         "i18next":  "^25.1.0",
                         "lucide-react":  "^1.27.0",
                         "react-i18next":  "^15.5.0",
                         "react-markdown":  "^10.1.0",
                         "rehype-highlight":  "^7.0.2",
                         "remark-gfm":  "^4.0.1",
                         "tailwind-merge":  "^3.2.0",
                         "zustand":  "^5.0.0"
                     },
    "peerDependencies":  {
                             "react":  "^19.1.0",
                             "react-dom":  "^19.1.0"
                         },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.1.0",
                            "@types/react":  "^19.1.0",
                            "@types/react-dom":  "^19.1.0",
                            "tailwindcss":  "^4.1.0",
                            "tsup":  "^8.4.0",
                            "tw-animate-css":  "^1.4.0",
                            "typescript":  "^7.0.2",
                            "vitest":  "^3.0.0"
                        }
}