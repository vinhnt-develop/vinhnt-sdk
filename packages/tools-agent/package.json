{
  "name": "@vinhnt-sdk/tools-agent",
  "version": "0.1.3",
  "description": "Agent-interaction tool family for VNT Agent — question, todo, agent-to-agent and skill tool providers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git",
    "directory": "packages/tools-agent"
  },
  "homepage": "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/tools-agent",
  "bugs": { "url": "https://github.com/vinhnt-develop/vinhnt-sdk/issues" },
  "keywords": ["vnt", "tools", "agent", "skill", "question", "todo"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vinhnt-sdk/tools": "workspace:*",
    "zod": "^4.4.3"
  }
}