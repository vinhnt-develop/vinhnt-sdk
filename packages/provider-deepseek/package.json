{
    "name": "@vinhnt-sdk/provider-deepseek",
    "version": "0.1.3",
    "description": "DeepSeek model provider tip — wires the OpenAI-compatible base provider with the DeepSeek base URL, default model and capability flags",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git",
        "directory": "packages/provider-deepseek"
    },
    "homepage": "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/provider-deepseek",
    "bugs": {
        "url": "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
    },
    "keywords": [
        "vnt",
        "deepseek",
        "provider",
        "llm",
        "openai"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@vinhnt-sdk/provider-openai-compatible": "workspace:*",
        "@vinhnt-sdk/schema": "workspace:*"
    },
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
        "prepublishOnly": "pnpm build",
        "test": "vitest run",
        "lint": "eslint ."
    }
}