{
    "name": "@vinhnt-sdk/model-adapters",
    "version": "0.1.0",
    "description": "AI model adapters for VNT Agent — OpenAI, Anthropic, and Google via AI SDK",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist", "LICENSE", "README.md"],
    "sideEffects": false,
    "engines": { "node": ">=20" },
    "repository": {
        "type": "git",
        "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
        "directory": "packages/model-adapters"
    },
    "homepage": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/model-adapters",
    "bugs": { "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues" },
    "keywords": ["vnt", "model", "adapter", "openai", "anthropic", "ai-sdk", "llm"],
    "publishConfig": { "access": "public" },
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@vinhnt-sdk/agent-core": "workspace:*",
        "@vinhnt-sdk/schema": "workspace:*",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "ai": ">=4.0.0",
        "@ai-sdk/openai": ">=4.0.0",
        "@ai-sdk/anthropic": ">=4.0.0",
        "@ai-sdk/google": ">=4.0.0",
        "tiktoken": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "@ai-sdk/openai": { "optional": true },
        "@ai-sdk/anthropic": { "optional": true },
        "@ai-sdk/google": { "optional": true },
        "tiktoken": { "optional": true }
    },
    "devDependencies": {
        "@ai-sdk/anthropic": "^4.0.15",
        "@ai-sdk/google": "^4.0.18",
        "@ai-sdk/openai": "^4.0.15",
        "ai": "^7.0.29",
        "tiktoken": "^1.0.22"
    }
}
