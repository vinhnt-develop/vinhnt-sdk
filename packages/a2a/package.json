{
  "name": "@vinhnt-sdk/a2a",
  "version": "0.1.0",
  "description": "A2A (Agent-to-Agent) protocol support for VNT Agent — agent discovery, communication, and task delegation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
    "directory": "packages/a2a"
  },
  "homepage": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/a2a",
  "bugs": {
    "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
  },
  "keywords": [
    "vnt",
    "a2a",
    "agent-to-agent",
    "protocol",
    "discovery"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@vinhnt-sdk/core": "workspace:*",
    "@vinhnt-sdk/schema": "workspace:*"
  }
}
