{
  "name": "@vinhnt-sdk/store-drizzle",
  "version": "0.1.3",
  "description": "Drizzle ORM persistence for VNT Agent — SQLite RunEventStore and SessionStore",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git",
    "directory": "packages/store-drizzle"
  },
  "homepage": "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/store-drizzle",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
  },
  "keywords": [
    "vnt",
    "store",
    "drizzle",
    "sqlite",
    "persistence",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vinhnt-sdk/schema": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1"
  }
}
