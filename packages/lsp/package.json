{
  "name": "@vinhnt-sdk/lsp",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/lsp",
  "bugs": {
    "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyen-thanh-vinh/vinhnt-sdk.git",
    "directory": "packages/lsp"
  },
  "keywords": [
    "vnt",
    "lsp",
    "language-server",
    "diagnostics",
    "code-analysis"
  ],
  "description": "LSP client pool and tools for VNT Agent — auto-detect, connect, and query language servers",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build"
  },
  "sideEffects": false,
  "dependencies": {
    "@vinhnt-sdk/core": "workspace:*",
    "@vinhnt-sdk/schema": "workspace:*",
    "zod": "^4.4.3"
  }
