{
    "name":  "@vinhnt-sdk/plugin",
    "version":  "0.1.4",
    "description":  "Plugin SDK for VNT Agent — define plugins with TypeScript hooks and auto-install support",
    "license":  "MIT",
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "dist",
                  "LICENSE",
                  "README.md"
              ],
    "sideEffects":  false,
    "engines":  {
                    "node":  "\u003e=20"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/vinhnt-develop/vinhnt-sdk.git",
                       "directory":  "packages/plugin"
                   },
    "homepage":  "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/plugin",
    "bugs":  {
                 "url":  "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
             },
    "keywords":  [
                     "vnt",
                     "plugin",
                     "sdk",
                     "extension",
                     "hooks"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsc -b",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "lint":  "eslint .",
                    "clean":  "node -e \"try{require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})}catch(e){}\" \u0026\u0026 node -e \"try{require(\u0027fs\u0027).rmSync(\u0027tsconfig.tsbuildinfo\u0027,{force:true})}catch(e){}\"",
                    "prepublishOnly":  "pnpm build"
                },
    "dependencies":  {
                         "@vinhnt-sdk/core":  "workspace:*"
                     }
}
