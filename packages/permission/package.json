{
  "name": "@vinhnt-sdk/permission",
  "version": "0.1.3",
  "description": "Permission kernel primitive for VNT Agent — rule types, permission matching/checking, risk rules, and approval stores, decoupled from core",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git",
    "directory": "packages/permission"
  },
  "homepage": "https://github.com/vinhnt-develop/vinhnt-sdk/tree/main/packages/permission",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk/issues"
  },
  "keywords": [
    "vnt",
    "permission",
    "approval",
    "policy",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vinhnt-sdk/schema": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint ."
  }
}