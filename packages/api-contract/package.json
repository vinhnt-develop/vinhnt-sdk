    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.js"
                          }
                },
    "types":  "./dist/index.d.ts",
    "homepage":  "https://github.com/nguyen-thanh-vinh/vinhnt-sdk/tree/main/packages/api-contract",
    "bugs":  {
