{
  "name": "@vinhnt-sdk/api-contract",
  "version": "0.1.0",
  "engines": { "node": ">=20" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/vinhnt-develop/vnt-agent/tree/main/packages/api-contract",
  "bugs": {
    "url": "https://github.com/vinhnt-develop/vnt-agent/issues"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
