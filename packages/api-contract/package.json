                   },
    "keywords":  [
                     "vnt",
                     "api",
                     "contract",
                     "zod",
                     "schema"
                 ],
    "description":  "Shared Zod schemas for VNT Agent HTTP/WS/job API contracts",
    "publishConfig":  {
