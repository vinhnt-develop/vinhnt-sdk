{
  "name": "vinhnt-sdk",
  "private": true,
  "description": "VinhNT SDK - AI Agent Core Libraries",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "build:fast": "turbo build --parallel",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "vitest run",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "check:deps": "node scripts/check-dep-graph.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check": "pnpm check:deps && pnpm check:hygiene",
    "test:coverage": "vitest run --coverage",
    "quality": "node scripts/verify-export-jsdoc.mjs && node scripts/check-export-map.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "pnpm build && pnpm test:run && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9",
    "turbo": "^2.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8",
    "vitest": "^3.2.0"
  }
}
