{
  "name": "vinhnt-sdk",
  "private": true,
  "description": "VinhNT SDK - AI Agent Core Libraries",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "build:fast": "turbo build --parallel",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.tests.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "turbo test",
    "test:run": "vitest run",
    "lint": "turbo lint && node scripts/check-docs-exports.mjs && node scripts/check-dead-exports.mjs --gate && node scripts/check-hygiene.mjs && node scripts/check-version-sync.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:version-sync": "node scripts/check-version-sync.mjs",
    "clean": "turbo clean",
    "test:coverage": "node scripts/run-coverage.mjs",
    "eval": "vitest run --project evals",
    "docs:check": "node scripts/check-docs-exports.mjs",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "publish:fix-deps": "node scripts/fix-workspace-deps.mjs",
    "publish:all": "node scripts/fix-workspace-deps.mjs && turbo build && pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9",
    "ts-morph": "^28.0.0",
    "turbo": "^2.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8",
    "vitest": "^3.2.0"
  },
  "version": "0.4.0"
}
