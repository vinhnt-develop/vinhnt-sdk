{
  "name": "vinhnt-sdk",
  "private": true,
  "description": "VinhNT SDK - AI Agent Core Libraries",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinhnt-develop/vinhnt-sdk.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "build:fast": "turbo build --parallel",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.tests.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "turbo test",
    "test:run": "vitest run",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "test:coverage": "vitest run --coverage",
    "docs:generate": "node scripts/generate-api-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9",
    "ts-morph": "^28.0.0",
    "turbo": "^2.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8",
    "vitest": "^3.2.0"
  }
}
